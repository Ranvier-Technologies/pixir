---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import pixirUsage from "../../../docs/benchmarks/scale/audit64-children-usage.json";
import codexUsage from "../../../docs/benchmarks/scale/audit64-codex-summary.json";
import pixirSamples from "../../../docs/benchmarks/scale/audit64-rss-samples-pixir.txt?raw";
import codexSamples from "../../../docs/benchmarks/scale/audit64-rss-samples-codex.txt?raw";

const bundle = "https://github.com/Ranvier-Technologies/pixir/tree/main/docs/benchmarks/scale";
const source = "https://github.com/Ranvier-Technologies/pixir/blob/main/docs/benchmarks/scale";
const p = pixirUsage.totals;
const c = codexUsage.totals;
function peakMiB(raw: string) {
  if (!raw.trim()) throw new Error("Missing RSS evidence");
  const values = raw.trim().split("\n").map((line) => Number(line.trim().split(/\s+/)[0]));
  if (values.some((value) => !Number.isSafeInteger(value) || value < 0) || Math.max(...values) <= 0) {
    throw new Error("Invalid RSS evidence");
  }
  return Math.max(...values) / 1024;
}
const memory = [
  { label: "Pixir delegate", mib: peakMiB(pixirSamples), kind: "pixir" },
  { label: "Process-per-worker", mib: peakMiB(codexSamples), kind: "baseline" },
];
const memoryMax = Math.max(...memory.map((row) => row.mib));
const ratio = memory[1].mib / memory[0].mib;
const number = (value: number) => value.toLocaleString("en-US", { maximumFractionDigits: 0 });
const tokenRows = [
  { label: "Total input tokens", pixir: p.input_tokens, baseline: c.input_tokens },
  { label: "Uncached input tokens", pixir: p.uncached_input_tokens, baseline: c.uncached_input_tokens },
  { label: "Reported output tokens", pixir: p.output_tokens, baseline: c.output_tokens },
];
---

<BaseLayout
  title="Pixir - Scale notes: measured overhead and limits"
  description="Historical July 2026 measurements of local agent-worker memory, process overhead, completion and elapsed time. Results, limitations and reproducible evidence."
  canonical="https://pixir.dev/scale"
>
  <div class="page">
    <Header />
    <main id="top">
      <section class="section" id="scale">
        <div class="section-inner">
          <p class="section-kicker">Evidence · July 2026</p>
          <h1 class="scale-title">Scaling local agent workers:<br />measured overhead and limits.</h1>
          <p class="section-lead">On one 32 GB Mac, Pixir used less sampled process-tree memory than a process-per-worker CLI baseline. Completion and elapsed time varied by workload. These results describe those configurations—not a universal speed or quality advantage.</p>
          <dl class="experiment-facts">
            <div><dt>Machine</dt><dd>macOS · arm64 · 32 GB</dd></div>
            <div><dt>Comparison</dt><dd>One shared Pixir runtime vs. separate <code>codex exec</code> workers</dd></div>
            <div><dt>Measurements</dt><dd>July 5–6, 2026 · up to 64 workers</dd></div>
          </dl>
          <p class="scope-note">Historical results, not benchmarks of the 0.1.16 candidate or Astra. The proc-pressure report identifies <code>gpt-5.5</code> / low effort and a pinned Pixir 0.1.5 benchmark binary; some older Codex version stamps are unavailable.</p>
          <div class="proof-grid">
            <article class="proof"><code>audit64 · one run</code><h3>{ratio.toFixed(1)}× RSS ratio</h3><p>{number(memory[0].mib)} vs. {number(memory[1].mib)} MiB at 64 workers. This is sampled process-tree RSS, not unique physical-memory accounting.</p></article>
            <article class="proof"><code>Completion varied</code><h3>Failures are part of the result.</h3><p>The first audit64 run completed 64/64 on both arms. A later ladder completed 199/205 in Pixir and 205/205 in the baseline.</p></article>
            <article class="proof"><code>No blanket speed claim</code><h3>Read each experiment separately.</h3><p>One comparable 64-worker run took 113 s vs. 112 s. The earlier audit64 run lacks a valid baseline batch timer.</p></article>
          </div>
          <nav class="section-links" aria-label="Scale notes sections">
            <a href="#scale-memory">Memory</a><a href="#scale-kernel">Processes</a><a href="#scale-outcomes">Time &amp; completion</a><a href="#scale-transport">Transport</a><a href="#scale-quality">Tokens &amp; findings</a><a href="#scale-method">Method &amp; sources</a>
          </nav>
        </div>
      </section>

      <section class="section tone-navy" id="scale-memory">
        <div class="section-inner">
          <p class="section-kicker">01 · Memory</p>
          <h2>A smaller sampled footprint in audit64.</h2>
          <p class="section-lead">Both arms audited 64 modules from this repository. The published samples reproduce a {ratio.toFixed(2)}× ratio between their peak RSS values. This comparison has one repetition.</p>
          <div class="meter-panel">
            <p class="meter-label">audit64 · July 5 · N=64 · shared axis, 0–{number(memoryMax)} MiB</p>
            {memory.map((row) => (
              <div class="memory-row">
                <span>{row.label}</span><strong>{number(row.mib)} MiB</strong>
                <div class="memory-track" aria-hidden="true"><div class:list={["memory-bar", row.kind]} style={{ width: `${row.mib / memoryMax * 100}%` }} /></div>
              </div>
            ))}
            <p class="panel-note">Peak of 187 Pixir samples and 545 baseline samples. Sampling can miss short-lived peaks; the tracked process set and timing window matter.</p>
          </div>
          <p class="section-lead">A separate synthetic ladder at N=1, 2, 4 and 8, with three repetitions per level, estimated marginal RSS of 6.5 MiB per additional Pixir child (bootstrap 95% interval: 4.9–7.7), versus 96.8 MiB (95.9–97.5) for the baseline. Those intervals describe that small ladder, not the N=64 run or every machine.</p>
          <p class="scope-note">No N=150 projection is plotted here. These measurements do not establish a swap threshold or the footprint of hundreds of concurrent workers. RAM workspace storage is also a different metric from process RSS.</p>
          <div class="section-links"><a href={source + "/audit64-rss-samples-pixir.txt"}>Pixir samples ↗</a><a href={source + "/audit64-rss-samples-codex.txt"}>Baseline samples ↗</a><a href={source + "/marginal-rss-ci95.json"}>Ladder estimates ↗</a></div>
        </div>
      </section>

      <section class="section" id="scale-kernel">
        <div class="section-inner">
          <p class="section-kicker">02 · Processes</p>
          <h2>Lower observed process and kernel overhead.</h2>
          <p class="section-lead">The separate proc-pressure experiment measured the tracked process trees, including helpers. A shared BEAM runtime is not literally one OS process. Its real-work measurements include transport and client overhead.</p>
          <div class="data-wrap" tabindex="0" role="region" aria-label="Proc-pressure measured totals">
            <table class="data">
              <caption>proc-pressure · July 6 · loaded-evening · N=64 · one run</caption>
              <thead><tr><th scope="col">Measured total</th><th scope="col">Pixir delegate</th><th scope="col">Process-per-worker</th></tr></thead>
              <tbody>
                <tr><th scope="row">Peak OS processes</th><td>6</td><td>474</td></tr>
                <tr><th scope="row">Peak threads</th><td>45</td><td>6,111</td></tr>
                <tr><th scope="row">Peak process-tree RSS</th><td>482 MiB</td><td>8,236 MiB</td></tr>
                <tr><th scope="row">Kernel CPU</th><td>16.9 s</td><td>187.1 s</td></tr>
                <tr><th scope="row">Involuntary context switches</th><td>0.69 M</td><td>4.93 M</td></tr>
              </tbody>
            </table>
          </div>
          <p class="panel-note">Different experiment, date and cache state from audit64 above. These totals are not evidence that all implementations of one architecture have the same cost.</p>
          <details class="method-details">
            <summary>View the controlled synthetic ladder</summary>
            <p>N=1–32, five repetitions per level, gpt-5.5 / low effort. The controlled low-ambient condition suppressed background activity; it was not a typical idle Mac. Values below are marginal slopes with bootstrap 95% intervals.</p>
            <div class="data-wrap" tabindex="0" role="region" aria-label="Synthetic marginal estimates">
              <table class="data">
                <thead><tr><th scope="col">Per additional worker</th><th scope="col">Pixir</th><th scope="col">Baseline</th></tr></thead>
                <tbody>
                  <tr><th scope="row">Peak threads</th><td>0.0 [0.0, 0.0]</td><td>100.5 [94.9, 104.4]</td></tr>
                  <tr><th scope="row">Peak OS processes</th><td>0.0 [0.0, 0.0]</td><td>8.0 [7.1, 8.7]</td></tr>
                  <tr><th scope="row">Involuntary context switches</th><td>2,445 [1.4k, 4.1k]</td><td>45,018 [42.8k, 47.9k]</td></tr>
                  <tr><th scope="row">Kernel CPU</th><td>0.04 s [0.03, 0.06]</td><td>1.30 s [1.25, 1.37]</td></tr>
                </tbody>
              </table>
            </div>
          </details>
          <aside class="correction-note" role="note"><strong>Correction: the “per provider call” comparison is withdrawn.</strong><p>The historical reconciler counts Pixir <code>provider_usage</code> events and Codex <code>turn.completed</code> events as the same unit. That does not establish comparable request counts. This page therefore excludes the earlier 34–55× context-switch and 31–82× CPU-per-call claims. The source exports remain unchanged for traceability.</p></aside>
          <div class="section-links"><a href={source + "/proc-pressure-report.md"}>Historical report ↗</a><a href={source + "/proc-pressure-reconcile.py"}>Inspect the reconciler ↗</a></div>
        </div>
      </section>

      <section class="section tone-mist" id="scale-outcomes">
        <div class="section-inner">
          <p class="section-kicker">03 · Time &amp; completion</p>
          <h2>Elapsed time and completion did not have one winner.</h2>
          <div class="data-wrap" tabindex="0" role="region" aria-label="Elapsed time by experiment">
            <table class="data">
              <caption>Batch elapsed time · compare within each row, not across workloads</caption>
              <thead><tr><th scope="col">Experiment</th><th scope="col">Pixir</th><th scope="col">Baseline</th></tr></thead>
              <tbody>
                <tr><th scope="row">Synthetic · N=16 · one run</th><td>28.9 s</td><td>21.4 s</td></tr>
                <tr><th scope="row">Synthetic · N=32 · one run</th><td>25.0 s</td><td>38.2 s</td></tr>
                <tr><th scope="row">audit64 · July 5 · N=64</th><td>202 s</td><td>Unavailable</td></tr>
                <tr><th scope="row">proc-pressure · July 6 · N=64</th><td>113 s</td><td>112 s</td></tr>
              </tbody>
            </table>
          </div>
          <p class="panel-note">The audit64 baseline has a reported maximum child duration of about 96 s, but its batch timer was contaminated by an orchestrator bug. That number is not an equivalent end-to-end comparison with Pixir's 202 s.</p>
          <div class="data-wrap" tabindex="0" role="region" aria-label="Completed children by experiment">
            <table class="data">
              <caption>Completed children · separate populations and builds</caption>
              <thead><tr><th scope="col">Run set</th><th scope="col">Pixir</th><th scope="col">Baseline</th></tr></thead>
              <tbody>
                <tr><th scope="row">audit64 · July 5</th><td>64/64</td><td>64/64</td></tr>
                <tr><th scope="row">proc-pressure · loaded ladder</th><td>199/205</td><td>205/205</td></tr>
                <tr><th scope="row">Pixir acceptance rerun · two builds</th><td>204/205</td><td>Not rerun</td></tr>
              </tbody>
            </table>
          </div>
          <p class="panel-note">The loaded ladder lost six Pixir children: three WebSocket reads, one WebSocket close and two provider server errors. Three retained partial output. The acceptance rerun used different builds; it is not a controlled estimate of a fix's effect.</p>
        </div>
      </section>

      <section class="section" id="scale-transport">
        <div class="section-inner">
          <p class="section-kicker">04 · Transport</p>
          <h2>31 fallback records in the audit64 run.</h2>
          <p class="section-lead">The export records {p.transports.http_sse} HTTP/SSE calls among {p.provider_calls} Pixir provider calls ({(p.transports.http_sse / p.provider_calls * 100).toFixed(1)}%). All 64 children completed that run. Completion alone does not prove the absence of duplicated effects.</p>
          <div class="data-wrap" tabindex="0" role="region" aria-label="Recorded fallback reasons">
            <table class="data"><caption>audit64 · recorded reasons</caption><thead><tr><th scope="col">Reason</th><th scope="col">Calls</th></tr></thead><tbody>
              <tr><th scope="row">websocket_handshake_failed</th><td>{p.fallback_reasons.websocket_handshake_failed}</td></tr>
              <tr><th scope="row">websocket_degraded</th><td>{p.fallback_reasons.websocket_degraded}</td></tr>
              <tr><th scope="row">websocket_closed</th><td>{p.fallback_reasons.websocket_closed}</td></tr>
            </tbody></table>
          </div>
          <p class="panel-note">N=16 and N=32 synthetic runs recorded no fallback; one N=8 repetition did. These are different workloads with limited repetitions, not a measured universal WebSocket threshold at 64 workers.</p>
          <div class="section-links"><a href={source + "/transport-evidence.json"}>Transport export ↗</a></div>
        </div>
      </section>

      <section class="section tone-mist" id="scale-quality">
        <div class="section-inner">
          <p class="section-kicker">05 · Tokens &amp; findings</p>
          <h2>Less uncached input is not less work—or better work.</h2>
          <p class="section-lead">audit64 asked both arms to inspect the same 64 modules. Both produced schema-valid JSON. Pixir reported fewer uncached input tokens, but more total input and output tokens.</p>
          <div class="data-wrap" tabindex="0" role="region" aria-label="Audit64 token totals">
            <table class="data"><caption>audit64 · totals reconciled from per-child exports</caption><thead><tr><th scope="col">Metric</th><th scope="col">Pixir</th><th scope="col">Baseline</th></tr></thead><tbody>
              {tokenRows.map((row) => <tr><th scope="row">{row.label}</th><td>{number(row.pixir)}</td><td>{number(row.baseline)}</td></tr>)}
            </tbody></table>
          </div>
          <p class="panel-note">These are usage counters, not a price quote or an answer-quality score. A completed Codex turn is not interchangeable with a Pixir provider call; call-count differences do not establish that one arm worked more deeply.</p>
          <p class="section-lead">The two arms agreed on four candidate major documentation findings. Agreement is useful corroboration, but the shared model can also share errors. Independent adjudication is needed before calling those findings correct or claiming superior quality.</p>
          <div class="section-links"><a href={source + "/audit64-children-usage.json"}>Pixir usage ↗</a><a href={source + "/audit64-codex-summary.json"}>Baseline usage ↗</a><a href={source + "/audit64-findings.md"}>Candidate findings ↗</a></div>
        </div>
      </section>

      <section class="section tone-navy" id="scale-method">
        <div class="section-inner">
          <p class="section-kicker">06 · Method &amp; sources</p>
          <h2>Reproduce the measurements.<br />Keep the limits attached.</h2>
          <ul class="method-list">
            <li><strong>One machine, historical configurations.</strong> Same model and account quota within the comparisons, but not neutral task authorship or broad hardware coverage. Loaded/quiet comparisons have incomplete Codex version stamps.</li>
            <li><strong>Small samples.</strong> The original synthetic ladder has three repetitions per level; its N=16/32 extensions and audit64 each have one. The controlled proc-pressure synthetic ladder has five per level. Do not transfer its confidence intervals to a single real-work run.</li>
            <li><strong>Sampled process-tree RSS.</strong> The reported memory is neither unique physical-memory accounting nor SSD usage. Helper processes and the sampling window belong in the measurement definition.</li>
            <li><strong>Public exports, local raw Logs.</strong> Redacted aggregates, samples, envelopes and scripts are published. They support arithmetic checks, but do not contain every raw event needed for full independent replay.</li>
          </ul>
          <p class="section-lead">From a Pixir source checkout, inspect the spec and rehearse before any paid or quota-consuming run:</p>
          <pre class="command-block"><code>mix deps.get
mix escript.build
./pixir delegate --spec docs/benchmarks/scale/audit64-spec.json --dry-run --json --timeout-ms 1200000</code></pre>
          <p class="scope-note">The dry-run does not call the model. Running without it launches up to 64 workers and consumes your configured provider quota. Historical results are not promises for a different model, version or machine.</p>
          <div class="section-links"><a href={bundle}>Browse all evidence ↗</a><a href={source + "/README.md"}>Reproduction notes ↗</a><a href="/#get-started">Start with one worker →</a></div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .scale-title { font-size: clamp(36px, 4.5vw, 60px); line-height: 1.1; }
  .experiment-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 32px 0 0; padding: 24px 0; border-block: 1px solid var(--line); }
  .experiment-facts dt { color: var(--subtle); font: 12px var(--mono); margin-bottom: 8px; }
  .experiment-facts dd { margin: 0; font-size: 15px; line-height: 1.6; }
  .scope-note, .panel-note { max-width: 850px; color: var(--muted); font-size: 14px; line-height: 1.7; margin: 20px 0 0; }
  .meter-panel { margin-top: 30px; padding: 24px; border: 1px solid var(--line); border-radius: 8px; background: var(--canvas); }
  .meter-label { margin: 0 0 24px; color: var(--muted); font: 13px/1.6 var(--mono); }
  .memory-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; margin-top: 24px; font-size: 15px; }
  .memory-row strong { font-variant-numeric: tabular-nums; }
  .memory-track { grid-column: 1 / -1; height: 10px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .memory-bar { height: 100%; }
  .memory-bar.pixir { background: var(--beam-cyan); }
  .memory-bar.baseline { background: var(--subtle); }
  .data-wrap { overflow-x: auto; margin-top: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--canvas); }
  .data { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; }
  .data caption { text-align: left; padding: 16px; color: var(--muted); font-size: 13px; }
  .data th, .data td { padding: 14px 16px; border-top: 1px solid var(--line); text-align: left; }
  .data thead th { font-size: 13px; color: var(--muted); }
  .data tbody th { font-weight: 500; }
  .data td { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .method-details { margin-top: 28px; border-top: 1px solid var(--line); padding-top: 16px; }
  .method-details summary { cursor: pointer; font-weight: 600; padding: 8px 0; }
  .method-details p { max-width: 850px; color: var(--muted); line-height: 1.7; }
  .correction-note { margin-top: 28px; padding: 24px; border-left: 3px solid #0284c7; background: #eaf2fb; border-radius: 0 8px 8px 0; max-width: 900px; }
  .correction-note p { margin-bottom: 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .method-list { padding-left: 22px; max-width: 880px; color: var(--muted); line-height: 1.75; }
  .method-list li { margin-top: 18px; }
  .method-list strong { color: var(--ink); }
  .command-block { max-width: 880px; border: 1px solid var(--line); }
  @media (max-width: 860px) { .experiment-facts { grid-template-columns: 1fr; gap: 20px; } }
  @media (max-width: 560px) { .data { font-size: 14px; } .data th, .data td { padding: 12px; } .meter-panel { padding: 18px; } }
</style>
